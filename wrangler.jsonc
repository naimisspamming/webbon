{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webbon",
  "compatibility_date": "2026-10-27",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webbon-db",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
