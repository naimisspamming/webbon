{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webbon",
  "compatibility_date": "2026-10-29",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
